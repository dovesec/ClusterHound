{
  "queries": [
    {
      "name": "[ClusterHound] All Nodes of a Specific Type",
      "queryList": [{ "final": true, "query": "MATCH p=(n:CH_Pod) RETURN p" }]
    },
    {
      "name": "[ClusterHound] All Edges of a Specific Type",
      "queryList": [{ "final": true, "query": "MATCH p=(a:CH)-[:CH_canExec]->(b:CH) RETURN p" }]
    },
    {
      "name": "[ClusterHound] All Edges from a Specific Object",
      "queryList": [{ "final": true, "query": "MATCH p=(n:CH {objectid: 'NAMESPACE/KIND/NAME'})-[r]->(m:CH) RETURN p" }]
    },
    {
      "name": "[ClusterHound] Specific Edge from a Specific Object",
      "queryList": [{ "final": true, "query": "MATCH p=(n:CH {objectid: 'NAMESPACE/KIND/NAME'})-[:CH_canExec]->(m:CH) RETURN p" }]
    },
    {
      "name": "[ClusterHound] Identities with Full Cluster Access",
      "queryList": [{ "final": true, "query": "MATCH p=(n:CH)-[:CH_fullAccess]->(c:CH_Cluster) RETURN p" }]
    },
    {
      "name": "[ClusterHound] Identities with Full Namespace Access",
      "queryList": [{ "final": true, "query": "MATCH p=(n:CH)-[:CH_fullAccess]->(ns:CH_Namespace) RETURN p" }]
    },
    {
      "name": "[ClusterHound] Nodes Proxy RCE",
      "queryList": [{ "final": true, "query": "MATCH p=(n:CH_Identity)-[:CH_nodesProxyRCE]->(c:CH_Cluster) RETURN p" }]
    },
    {
      "name": "[ClusterHound] Unauthenticated API and Kubelet Access",
      "queryList": [{ "final": true, "query": "MATCH p=(e:CH_ExternalActor)-[r:CH_unauthAPIAccess|CH_unauthKubeletAccess]->(n:CH) RETURN p" }]
    },
    {
      "name": "[ClusterHound] Shortest Path from Identity to Full Cluster Compromise",
      "queryList": [{ "final": true, "query": "MATCH p=shortestPath((n:CH_Identity)-[*1..10]->(c:CH_Cluster)) RETURN p" }]
    },
    {
      "name": "[ClusterHound] Identities that Can Bind Roles",
      "queryList": [{ "final": true, "query": "MATCH p=(n:CH_Identity)-[:CH_canBind]->(t:CH) RETURN p" }]
    },
    {
      "name": "[ClusterHound] Identities that Can Escalate Roles",
      "queryList": [{ "final": true, "query": "MATCH p=(n:CH_Identity)-[:CH_canEscalate]->(t:CH) RETURN p" }]
    },
    {
      "name": "[ClusterHound] Identities Holding Both canBind and canEscalate",
      "queryList": [{ "final": true, "query": "MATCH p=(n:CH)-[:CH_canBind]->(r:CH)<-[:CH_canEscalate]-(n) RETURN p" }]
    },
    {
      "name": "[ClusterHound] Identities that Can Create Service Account Tokens",
      "queryList": [{ "final": true, "query": "MATCH p=(n:CH_Identity)-[:CH_canCreateToken]->(t:CH) RETURN p" }]
    },
    {
      "name": "[ClusterHound] Identities that Can Impersonate",
      "queryList": [{ "final": true, "query": "MATCH p=(n:CH_Identity)-[:CH_canImpersonate]->(t:CH) RETURN p" }]
    },
    {
      "name": "[ClusterHound] Privileged Pods",
      "queryList": [{ "final": true, "query": "MATCH p=(pod:CH_Pod)-[:CH_podPrivileged]->(n:CH) RETURN p" }]
    },
    {
      "name": "[ClusterHound] Host Namespace Pods",
      "queryList": [{ "final": true, "query": "MATCH p=(pod:CH_Pod)-[r:CH_podHostPID|CH_podHostNetwork|CH_podHostIPC]->(n:CH) RETURN p" }]
    },
    {
      "name": "[ClusterHound] Shortest Paths from Pod to Critical Permissions",
      "queryList": [{ "final": true, "query": "MATCH p=(pod:CH_Pod)-[:CH_mountsServiceAccount]->(i:CH_Identity)-[r:CH_fullAccess|CH_nodesProxyRCE|CH_canBind|CH_canEscalate|CH_canExec|CH_canCreateWorkload|CH_canPatch|CH_canCreateEphemeral|CH_canImpersonate|CH_canCreateToken|CH_secretsRead]->(t:CH) RETURN p" }]
    },
    {
      "name": "[ClusterHound] Pods Reaching IMDS",
      "queryList": [{ "final": true, "query": "MATCH p=(pod:CH_Pod)-[:CH_accessIMDS]->(imds:CH_IMDSService) RETURN p" }]
    },
    {
      "name": "[ClusterHound] Identities that Can Exec into Pods",
      "queryList": [{ "final": true, "query": "MATCH p=(n:CH_Identity)-[:CH_canExec]->(t:CH) RETURN p" }]
    },
    {
      "name": "[ClusterHound] Identities that Can Create Pods",
      "queryList": [{ "final": true, "query": "MATCH p=(n:CH_Identity)-[e:CH_canCreateWorkload]->(t:CH) WHERE e.resource CONTAINS 'Pod' RETURN p" }]
    },
    {
      "name": "[ClusterHound] Identities that Can Create Workloads",
      "queryList": [{ "final": true, "query": "MATCH p=(n:CH_Identity)-[e:CH_canCreateWorkload]->(t:CH) WHERE any(k IN ['Deployment','StatefulSet','DaemonSet','ReplicaSet','ReplicationController','Job','CronJob'] WHERE e.resource CONTAINS k) RETURN p" }]
    },
    {
      "name": "[ClusterHound] Identities that Can Patch Pods",
      "queryList": [{ "final": true, "query": "MATCH p=(n:CH_Identity)-[e:CH_canPatch]->(t:CH) WHERE e.resource CONTAINS 'Pod' RETURN p" }]
    },
    {
      "name": "[ClusterHound] Identities that Can Patch Workloads",
      "queryList": [{ "final": true, "query": "MATCH p=(n:CH_Identity)-[e:CH_canPatch]->(t:CH) WHERE any(k IN ['Deployment','StatefulSet','DaemonSet','ReplicaSet','ReplicationController','Job','CronJob'] WHERE e.resource CONTAINS k) RETURN p" }]
    },
    {
      "name": "[ClusterHound] Identities that Can Read Secrets",
      "queryList": [{ "final": true, "query": "MATCH p=(n:CH_Identity)-[:CH_secretsRead]->(t:CH) RETURN p" }]
    },
    {
      "name": "[ClusterHound] Identities that Can Create Secrets",
      "queryList": [{ "final": true, "query": "MATCH p=(n:CH_Identity)-[:CH_secretsCreate]->(t:CH) RETURN p" }]
    },
    {
      "name": "[ClusterHound] Service Account Assumption Edges",
      "queryList": [{ "final": true, "query": "MATCH p=(n:CH_Identity)-[:CH_canAssumeServiceAccount]->(sa:CH_Identity) WHERE n.namespace IS NULL OR n.namespace <> 'kube-system' RETURN p" }]
    },
    {
      "name": "[ClusterHound] Entry Point to Critical Permissions via SA Assumption (up to 3 hops)",
      "queryList": [{ "final": true, "query": "MATCH p=(svc:CH_Service)-[:CH_entryPoint]->(:CH_Pod)-[:CH_mountsServiceAccount]->(:CH_Identity)-[:CH_canAssumeServiceAccount*1..3]->(sa:CH_Identity)-[:CH_fullAccess|CH_nodesProxyRCE|CH_canBind|CH_canEscalate|CH_secretsRead|CH_secretsCreate|CH_canCreateToken|CH_canImpersonate]->(t:CH) RETURN p" }]
    },
    {
      "name": "[ClusterHound] Identities that Can Port Forward",
      "queryList": [{ "final": true, "query": "MATCH p=(n:CH_Identity)-[:CH_canPortForward]->(t:CH) RETURN p" }]
    },
    {
      "name": "[ClusterHound] All Entry Points",
      "queryList": [{ "final": true, "query": "MATCH p=(svc:CH_Service)-[:CH_entryPoint]->(pod:CH_Pod) RETURN p" }]
    },
    {
      "name": "[ClusterHound] Full Attack Chain - Entry Point to Critical Permissions",
      "queryList": [{ "final": true, "query": "MATCH p=(svc:CH_Service)-[:CH_entryPoint]->(pod:CH_Pod)-[:CH_mountsServiceAccount]->(i:CH_Identity)-[r:CH_fullAccess|CH_nodesProxyRCE|CH_canBind|CH_canEscalate|CH_canExec|CH_canCreateWorkload|CH_canPatch|CH_canCreateEphemeral|CH_canImpersonate|CH_canCreateToken|CH_secretsRead]->(t:CH) RETURN p" }]
    },
    {
      "name": "[ClusterHound] Pods with Write Volume Mounts",
      "queryList": [{ "final": true, "query": "MATCH p=(pod:CH_Pod)-[:CH_hasWriteVolume]->(v:CH_Volume) RETURN p" }]
    },
    {
      "name": "[ClusterHound] Pods with Read Volume Mounts",
      "queryList": [{ "final": true, "query": "MATCH p=(pod:CH_Pod)-[:CH_hasReadVolume]->(v:CH_Volume) RETURN p" }]
    },
    {
      "name": "[ClusterHound] All Edges from a Namespace",
      "queryList": [{ "final": true, "query": "MATCH p=(src:CH)-[r]->(tgt:CH) WHERE src.namespace = 'namespace' RETURN p" }]
    },
    {
      "name": "[ClusterHound] Cross-Namespace and Cluster-Wide Edges from a Namespace",
      "queryList": [{ "final": true, "query": "MATCH p=(src:CH)-[r]->(tgt:CH) WHERE src.namespace = 'namespace' AND (tgt.namespace IS NULL OR tgt.namespace = '' OR tgt.namespace <> 'namespace') RETURN p" }]
    },
    {
      "name": "[ClusterHound] Pods in Namespace via Service Accounts to All Permissions",
      "queryList": [{ "final": true, "query": "MATCH p=(pod:CH_Pod {namespace: 'namespace'})-[:CH_mountsServiceAccount]->(i:CH_Identity)-[r]->(t:CH) RETURN p" }]
    },
    {
      "name": "[ClusterHound] Token Creation Pivot to Privileged Identities",
      "queryList": [{ "final": true, "query": "MATCH (attacker:CH_Identity)-[:CH_canCreateToken]->(ns:CH_Namespace) MATCH (sa:CH_Identity)-[r]->(t:CH) WHERE sa.namespace = toLower(ns.name) RETURN attacker, ns, sa, r, t" }]
    },
    {
      "name": "[ClusterHound] Impersonation Pivot to Privileged Identities",
      "queryList": [{ "final": true, "query": "MATCH (attacker:CH_Identity)-[:CH_canImpersonate]->(ns:CH_Namespace) MATCH (sa:CH_Identity)-[r]->(t:CH) WHERE sa.namespace = toLower(ns.name) RETURN attacker, ns, sa, r, t" }]
    }
  ]
}
